`,fortran:`! CW2 example
program TestCases
  use CW2
  use Solution
implicit none
  call describe("add")
    call it("adds integers")
      call assertEquals(2, add(1, 1))
    call endContext()
  call endContext()
end program
`,fsharp:`module ExampleTests

open ExampleSolution
// NUnit is used to test F# 6.0.
open NUnit.Framework

[<Test>]
let TestAdd() =
    Assert.AreEqual(2, add 1 1)

[<TestFixture>]
type FixedTests() =
    [<Test>]
    member this.TestOne() =
        Assert.AreEqual(1, add 0 1)
